  "type": "module",
  "description": "A minimal, cross-platform EPUB reader for the desktop.",
  "license": "MIT",
  "author": "Victor Ugrinovich",
  "repository": {
    "type": "git",
    "url": "https://github.com/victorugri/folio.git"
